#!/bin/sh /etc/rc.common
# Optional OpenWrt procd service. Install Python/dependencies separately.
START=95
STOP=10
USE_PROCD=1

start_service() {
    umask 077
    SMART_HOME_DB=/opt/smart-home-service/data/smarthome.db
    SMART_HOME_API_TOKEN=
    SMART_HOME_BIND=127.0.0.1
    SMART_HOME_PORT=8000
    SMART_HOME_SERVICE_USER=root
    # Optional root-owned mode-0600 shell config using the variables above.
    [ ! -f /etc/smart-home-service.conf ] || . /etc/smart-home-service.conf
    procd_open_instance
    procd_set_param command /usr/bin/python3 -m uvicorn smarthome.main:app \
        --app-dir /opt/smart-home-service --host "$SMART_HOME_BIND" --port "$SMART_HOME_PORT" --workers 1
    procd_set_param env SMART_HOME_DB="$SMART_HOME_DB" SMART_HOME_API_TOKEN="$SMART_HOME_API_TOKEN" \
        SMART_HOME_TUYA_TIMEOUT=3 SMART_HOME_LOCK_TIMEOUT=5
    procd_set_param user "$SMART_HOME_SERVICE_USER"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
