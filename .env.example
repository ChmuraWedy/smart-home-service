# Environment variables; no automatic .env loader. Export values before starting.
SMART_HOME_DB=./data/smarthome.db
SMART_HOME_API_TOKEN=replace-with-a-long-random-token
SMART_HOME_TUYA_TIMEOUT=3
SMART_HOME_LOCK_TIMEOUT=5
# Comma-separated exact browser origins. Empty = no cross-origin browser access.
SMART_HOME_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Optional compatibility redirect from the old /cloud page (no UI files in Python).
SMART_HOME_FRONTEND_URL=http://127.0.0.1:5173

# Passive Tuya announcements are shared across cards and the network page.
SMART_HOME_NETWORK_MONITOR_ENABLED=1

SMART_HOME_DISPLAY_POLL_INTERVAL=30

SMART_HOME_CLOUD_ENABLED=0
# SMART_HOME_CLOUD_SESSION=./data/tuya-cloud.json
# SMART_HOME_CLOUD_CLIENT_ID=HA_3y9q4ak7g4ephrvke
# SMART_HOME_CLOUD_SCHEMA=haauthorize
# Independent Developer credentials file (default: <QR-session-path>.developer.json)
# SMART_HOME_DEVELOPER_SESSION=./data/tuya-developer.json
SMART_HOME_CLOUD_TIMEOUT=10

# Optional AI chat. Set the browser-accessible HTTPS URL for Home Voice Classic Chat.
# SMART_HOME_AI_CHAT_EMBED_URL=https://homeassistant.dom:8013/embed
